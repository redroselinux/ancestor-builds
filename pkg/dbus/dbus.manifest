author :: Edward :: EdwardGroves20007@proton.me
package :: dbus :: 1.16.2
build_deps :: meson ninja gcc expat
download :: manual :: https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz
manual_extract :: tar -xf <placeholder> --strip-components=1 -C <dir>
build :: manual :: meson setup build --prefix=/usr --libexecdir=/usr/libexec --sysconfdir=/etc --localstatedir=/var -Dman=disabled -Dxml_docs=disabled
build :: manual :: ninja -C build
install_cmd :: manual :: DESTDIR=<placeholder> ninja -C build install
